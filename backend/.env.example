# App
APP_NAME="Clinical AI Assistant"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=local

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinical_ai

# AWS (leave blank for local development)
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
